# ─── FilmStack Environment Configuration ─────────────────────────────
# Copy this file to .env and fill in your values.
# Required variables are marked with (required).
#
# For Docker Compose: docker compose up -d
# For local dev:      npm run dev

# ─── Database (required) ─────────────────────────────────────────────
DB_NAME=filmstack
DB_USER=filmstack
DB_PASSWORD=                    # (required) PostgreSQL password
DATABASE_URL=postgresql://filmstack:YOUR_PASSWORD@localhost:5432/filmstack

# ─── Redis (required) ────────────────────────────────────────────────
REDIS_PASSWORD=                 # (required) Redis password
REDIS_URL=redis://:YOUR_PASSWORD@localhost:6379

# ─── Auth Secrets (required) ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=                     # (required) Min 32 chars
JWT_REFRESH_SECRET=             # (required) Min 32 chars, different from JWT_SECRET
CSRF_SECRET=                    # (required) Min 32 chars

# ─── URLs ─────────────────────────────────────────────────────────────
NODE_ENV=development
FESTIVAL_URL=http://localhost:3000
STREAMING_URL=http://localhost:3003
FESTIVAL_API_URL=http://localhost:3001
STREAMING_API_URL=http://localhost:3002

# Optional: apex domain shown in the festival UI for tenant subdomains
# VITE_ROOT_DOMAIN=localhost

# ─── Stripe (for payments) ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@filmstack.com

# ─── File Storage (local disk) ────────────────────────────────────────
# Festival and streaming uploads are stored on the local filesystem.
UPLOAD_PATH=./uploads

# ─── CDN (optional) ──────────────────────────────────────────────────
USE_CDN=false
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
CDN_HOSTNAME=

# ─── Monitoring (optional) ───────────────────────────────────────────
SENTRY_DSN=
